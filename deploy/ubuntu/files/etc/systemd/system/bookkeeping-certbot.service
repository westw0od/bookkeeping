[Unit]
Description=Renew short-lived Let's Encrypt IP certificate
After=network-online.target nginx.service
Wants=network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=3
[Service]
Type=oneshot
ExecStart=/opt/certbot/bin/certbot renew --quiet --max-log-backups 3 --no-random-sleep-on-renew
TimeoutStartSec=600
Restart=on-failure
RestartSec=15m
