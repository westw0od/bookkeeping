#!/usr/bin/env bash
set -euo pipefail
umask 077
root=/var/backups/bookkeeping
stamp=$(date -u +%Y%m%dT%H%M%SZ)
install -d -m 700 "$root/$stamp"
mysqldump --single-transaction --no-tablespaces --set-gtid-purged=OFF bookkeeping | gzip >"$root/$stamp/database.sql.gz"
tar -czf "$root/$stamp/private-config-uploads.tar.gz" -C /opt/bookkeeping backend/.env backend/uploads
find "$root" -mindepth 2 -maxdepth 2 -type f -mtime +7 -delete
find "$root" -mindepth 1 -maxdepth 1 -type d -empty -delete
